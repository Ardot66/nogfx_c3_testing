#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 64) in;

layout(buffer_reference, scalar) readonly buffer Input { float value[]; };
layout(buffer_reference, scalar) writeonly buffer Output { float value[]; };

layout(set = 0, binding = 0, scalar) uniform Root { 
    Input in_buf;
    Output out_buf;
    uint count;
} root;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if(i < root.count) {
        root.out_buf.value[i] = root.in_buf.value[i] * 2.0;
    }
}